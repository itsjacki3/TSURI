# Copy this file to .env and fill in your Supabase project's values.
# Find both of these in Supabase: Project Settings -> API.
#
# VITE_SUPABASE_ANON_KEY is the PUBLIC "anon" key — it is safe to ship in a
# browser bundle (that's what it's designed for) as long as Row Level
# Security is enabled on your tables, which supabase/02_react_client_migration.sql
# sets up for you. Never put your "service_role" key here — that one bypasses
# RLS entirely and must never be shipped to a browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
